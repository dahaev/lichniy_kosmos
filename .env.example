# Local development defaults. Copy to .env if you need overrides; .env is git-ignored.
# Values below are for the throwaway dev database from deploy/compose.dev.yaml only.
COSMOS_ENV=local
COSMOS_HTTP_ADDR=127.0.0.1:8080
COSMOS_DATABASE_URL=postgres://cosmos:cosmos@127.0.0.1:55432/cosmos?sslmode=disable
COSMOS_LOG_LEVEL=debug
COSMOS_LOG_FORMAT=text
COSMOS_SHUTDOWN_TIMEOUT=30s
COSMOS_READY_TIMEOUT=2s

# Integration tests run against a separate database in the same dev container.
COSMOS_TEST_DATABASE_URL=postgres://cosmos:cosmos@127.0.0.1:55432/cosmos_test?sslmode=disable
